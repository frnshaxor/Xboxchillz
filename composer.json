{
    "name": "arsip-layar/arsip-layar",
    "description": "Self-hosted video sharing platform",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "files": [
            "app/helpers.php",
            "app/Database/Connection.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "find app/ controllers/ routes/ cli/ tests/ -name \"*.php\" -exec php -l {} \\;",
        "phpstan": "vendor/bin/phpstan analyse",
        "phpstan:analyze": "vendor/bin/phpstan analyse --level=5",
        "cs-fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "cs-check": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
